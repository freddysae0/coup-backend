# Copy to .env and fill in. Never commit .env.

# --- Backend ---------------------------------------------------------------
# Token for the read-only /admin API (stats, rooms, live events).
# Leave empty to disable the admin API entirely (404).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Time to challenge/block before auto-pass, in ms (0 = never).
RESPONSE_TIMEOUT_MS=30000
# A player offline this long during a game forfeits, in ms (0 = never).
DISCONNECT_GRACE_MS=120000

# --- Telegram bot ----------------------------------------------------------
# Uncomment to start the bot container with docker compose.
# COMPOSE_PROFILES=telegram
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to use the bot. Everybody else only gets
# their chat id back (send /start to the bot to find yours).
TELEGRAM_ALLOWED_CHAT_IDS=
# Where the bot reaches the backend. docker-compose sets http://backend:8000.
BACKEND_URL=http://localhost:8000
# Live moves are batched and sent at most once per this interval, in ms.
TELEGRAM_FLUSH_MS=3000
# Optional file to remember followed rooms and /avisos across restarts
# (docker-compose sets /data/telegram-state.json on a volume).
TELEGRAM_STATE_FILE=
